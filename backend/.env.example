# بيئة التشغيل
NODE_ENV=development
PORT=5000

# رابط قاعدة بيانات PostgreSQL (سواء محلية أو على Neon / Supabase / Render)
DATABASE_URL="postgresql://username:password@localhost:5432/dar_al_uloom?schema=public"

# مفاتيح تشفير JWT (يمكن توليد نصوص عشوائية قوية)
JWT_ACCESS_SECRET="your_very_secure_jwt_access_secret_key_change_in_production_32chars"
JWT_REFRESH_SECRET="your_very_secure_jwt_refresh_secret_key_change_in_production_32chars"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# رابط الواجهة الأمامية المسموح به في CORS
FRONTEND_URL="http://localhost:5173,https://dar-as-salaf.vercel.app"

# إعدادات التخزين
STORAGE_DRIVER=local
UPLOAD_DIR="./uploads"
MAX_UPLOAD_BYTES=52428800

# بيانات المدير الافتراضي عند تشغيل البذر (seed)
ADMIN_EMAIL="admin@dar-al-uloom.com"
ADMIN_PASSWORD="Admin@ChangeThisPassword123"
ADMIN_NAME="مدير المنصة"
